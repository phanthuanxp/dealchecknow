DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taxininhbinh?schema=public"
AUTH_SECRET="replace_with_a_long_random_secret"
TELEGRAM_BOT_TOKEN="replace_with_telegram_bot_token"
TELEGRAM_CHAT_ID="replace_with_telegram_chat_id"
BLOB_READ_WRITE_TOKEN="replace_with_vercel_blob_read_write_token"

# App
NEXT_PUBLIC_SITE_URL="https://taxininhbinh.com"

# Optional: CMS domain redirect for admin paths.
# When enabled in production, /admin* and /admincp* on public domain redirect to CMS_BASE_URL.
# CMS_BASE_URL="https://cms.30nice.vn"
# CMS_ADMIN_REDIRECT_ENABLED="false"
# CMS_NOINDEX_ENABLED="true"
# CMS_SECURITY_HEADERS_ENABLED="true"
# CMS_LOGIN_RATE_LIMIT_ENABLED="true"
# CMS_LOGIN_RATE_LIMIT_MAX_ATTEMPTS="20"
# CMS_LOGIN_RATE_LIMIT_WINDOW_SECONDS="300"
# Optional strict allowlist for accessing /admin* on CMS domain (comma-separated IPs)
# CMS_ADMIN_ALLOWED_IPS="1.2.3.4,8.8.8.8"

# NEXTAUTH_URL is optional on local, recommended for production outside Vercel.
# NEXTAUTH_URL="https://taxininhbinh.com"

# Optional: bootstrap 2 admin accounts for CMS (script prisma:provision:stage1)
# BOOTSTRAP_ADMINTRIP_PASSWORD="replace_with_secure_password"
# BOOTSTRAP_QUANLYCP_PASSWORD="replace_with_secure_password"
