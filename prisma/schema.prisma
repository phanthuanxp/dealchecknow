generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  QUOTED
  CONFIRMED
  CANCELLED
}

enum SectionType {
  HOME
  HERO
  SERVICES
  PRICING
  FAQ
  TESTIMONIAL
  BLOG
  CTA
  FOOTER
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model Tenant {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  cmsDomain       String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  domains         TenantDomain[]
  users           User[]
  siteSections    SiteSection[]
  pageBlocks      PageBlock[]
  blogCategories  BlogCategory[]
  blogPosts       BlogPost[]
  faqs            Faq[]
  testimonials    Testimonial[]
  pricingItems    PricingItem[]
  quoteRequests   QuoteRequest[]
  contactMessages ContactMessage[]
  siteSettings    SiteSetting[]
  mediaAssets     MediaAsset[]
  servicePages    ServicePage[]

  @@index([isActive, slug])
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  domain    String   @unique
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPrimary])
  @@index([tenantId, isActive])
}

model User {
  id                     String           @id @default(cuid())
  tenantId               String?
  email                  String           @unique
  passwordHash           String
  fullName               String
  role                   UserRole         @default(EDITOR)
  isActive               Boolean          @default(true)
  emailVerified          DateTime?
  avatarUrl              String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  accounts               Account[]
  sessions               Session[]
  posts                  BlogPost[]       @relation("BlogAuthor")
  quoteRequestsHandled   QuoteRequest[]   @relation("QuoteHandledBy")
  contactMessagesHandled ContactMessage[] @relation("ContactHandledBy")
  tenant                 Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([role, isActive])
  @@index([tenantId, role, isActive])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?  @db.Text
  accessToken       String?  @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?  @db.Text
  sessionState      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model SiteSection {
  id          String      @id @default(cuid())
  tenantId    String?
  key         String      @unique
  name        String
  type        SectionType @default(HOME)
  title       String?
  description String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  blocks      PageBlock[]
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([type, isActive, sortOrder])
  @@index([tenantId, type, isActive, sortOrder])
}

model PageBlock {
  id        String      @id @default(cuid())
  tenantId  String?
  sectionId String
  blockKey  String
  blockType String      @default("text")
  title     String?
  content   Json?
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  section   SiteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([sectionId, blockKey])
  @@index([sectionId, isActive, sortOrder])
  @@index([tenantId, sectionId, isActive, sortOrder])
}

model BlogCategory {
  id          String     @id @default(cuid())
  tenantId    String?
  name        String
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([tenantId, isActive, sortOrder])
}

model BlogPost {
  id             String        @id @default(cuid())
  tenantId       String?
  categoryId     String
  authorId       String?
  title          String
  slug           String        @unique
  excerpt        String?       @db.Text
  content        String        @db.Text
  coverImageUrl  String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  tags           String[]
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       BlogCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author         User?         @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([categoryId, status, publishedAt])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@index([tenantId, status, publishedAt])
}

model Faq {
  id        String   @id @default(cuid())
  tenantId  String?
  slug      String   @unique
  question  String
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([tenantId, isActive, sortOrder])
}

model Testimonial {
  id           String   @id @default(cuid())
  tenantId     String?
  code         String   @unique
  customerName String
  content      String   @db.Text
  rating       Int      @default(5)
  location     String?
  serviceName  String?
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([isActive, isFeatured, sortOrder])
  @@index([tenantId, isActive, isFeatured, sortOrder])
}

model PricingItem {
  id           String   @id @default(cuid())
  tenantId     String?
  code         String   @unique
  routeName    String
  fromLocation String
  toLocation   String
  vehicleType  String
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @default("VND")
  unit         String   @default("trip")
  description  String?
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  showOnHome   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([vehicleType, isActive])
  @@index([isActive, sortOrder])
  @@index([showOnHome, isActive, sortOrder])
  @@index([tenantId, isActive, sortOrder])
}

model QuoteRequest {
  id              String             @id @default(cuid())
  tenantId        String?
  fullName        String
  phone           String
  email           String?
  pickupLocation  String
  dropoffLocation String
  pickupTime      DateTime?
  returnTime      DateTime?
  passengerCount  Int?
  luggageCount    Int?
  vehicleType     String?
  message         String?            @db.Text
  status          QuoteRequestStatus @default(NEW)
  estimatedPrice  Decimal?           @db.Decimal(12, 2)
  handledById     String?
  handledAt       DateTime?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  handledBy       User?              @relation("QuoteHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  tenant          Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([phone])
  @@index([email])
  @@index([handledById])
  @@index([tenantId, status, createdAt])
}

model ContactMessage {
  id          String               @id @default(cuid())
  tenantId    String?
  fullName    String
  phone       String?
  email       String?
  subject     String?
  message     String               @db.Text
  status      ContactMessageStatus @default(NEW)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  handledBy   User?                @relation("ContactHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  tenant      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
  @@index([handledById])
  @@index([tenantId, status, createdAt])
}

model SiteSetting {
  id          String   @id @default(cuid())
  tenantId    String?
  key         String   @unique
  value       Json
  description String?
  groupKey    String   @default("general")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([groupKey, isPublic])
  @@index([tenantId, groupKey, isPublic])
}

model MediaAsset {
  id        String   @id @default(cuid())
  tenantId  String?
  code      String   @unique
  title     String
  url       String
  altText   String?
  groupKey  String   @default("general")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([groupKey, isActive, sortOrder])
  @@index([tenantId, groupKey, isActive, sortOrder])
}

model ServicePage {
  id                  String   @id @default(cuid())
  tenantId            String?
  title               String
  slug                String   @unique
  shortDescription    String   @db.Text
  metaTitle           String?
  metaDescription     String?
  h1                  String?
  heroTitle           String?
  heroDescription     String?  @db.Text
  featuredImage       String?
  mainContent         String?  @db.Text
  contentBlocks       Json?
  pricingTable        Json?
  faqItems            Json?
  routeBenefits       String[]
  pickupLocations     String[]
  dropoffLocations    String[]
  trustHighlights     String[]
  relatedServiceSlugs String[]
  legacySlugs         String[]
  sortOrder           Int      @default(0)
  isPublished         Boolean  @default(false)
  canonicalUrl        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@index([sortOrder])
  @@index([tenantId, isPublished, sortOrder])
}
